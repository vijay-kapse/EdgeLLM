# Keep the build context small and hermetic. Anything the image genuinely needs
# is COPY'd explicitly in the Dockerfile; anything generated is mounted at run
# time via docker-compose.yml.

.git
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# Generated artifacts and measurements: mounted, never baked in. Baking them
# would let a stale model or an old benchmark table ride along inside the image.
artifacts/
results/

# Not part of the Linux container build.
android/
aihub/
site/
tests/

*.onnx
*.safetensors
*.gguf
.DS_Store
